# Kopirati u /etc/academiadelavida.env (vlasnik root, grupa adv, prava 640). NIKAD ne stavljati u javni kod.
# Komentari samo u zasebnim redcima; vrijednosti s razmacima u navodnicima.

# Dugi slučajni niz, npr.: python3 -c "import secrets;print(secrets.token_hex(32))"
ADV_SECRET_KEY="ZAMIJENITI"
ADV_BASE_URL="https://academiadelavida.hr"
ADV_DATA_DIR="/var/lib/academiadelavida"
ADV_BACKUP_DIR="/var/backups/academiadelavida"
ADV_BACKUP_KEEP="30"

# E-pošta (SMTP). Opcija A: Gmail udruge s lozinkom za aplikaciju (potrebna dvofaktorska prijava na Gmailu)
ADV_SMTP_HOST="smtp.gmail.com"
ADV_SMTP_PORT="587"
ADV_SMTP_STARTTLS="1"
ADV_SMTP_USER="academiadelavidaudruga@gmail.com"
ADV_SMTP_PASSWORD="ZAMIJENITI"
ADV_MAIL_FROM="Academia de la Vida <academiadelavidaudruga@gmail.com>"
ADV_MAIL_REPLY_TO="academiadelavidaudruga@gmail.com"
ADV_DIGEST_TO="academiadelavidaudruga@gmail.com"

# Prema odluci o članarini
ADV_PAYMENT_DUE_DAYS="15"
ADV_DECISION_REF_HR="Odluka Upravnog odbora o visini i načinu plaćanja članarine od 22. listopada 2026."
ADV_DECISION_REF_EN="Decision of the Management Board on the amount and payment of the membership fee of 22 October 2026"
ADV_REMINDER_DAYS="30"
